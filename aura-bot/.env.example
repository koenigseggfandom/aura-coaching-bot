# =============================================
# AURA Coaching Bot — Environment Variables
# =============================================

# Discord Bot Token (Discord Developer Portal'dan al)
DISCORD_TOKEN=your_bot_token_here
# Bot'un Client ID'si (Discord Developer Portal > Application > General Information)
CLIENT_ID=1499664876665176094
# Sunucunun ID'si (Discord'da sunucu simgesine sağ tıkla > ID Kopyala)
GUILD_ID=your_guild_id_here

# =============================================
# ROLLER (Discord sunucunda oluştur, ID kopyala)
# =============================================

# Öğrenci rolünün ID'si
STUDENT_ROLE_ID=your_student_role_id

# Koç rolünün ID'si
COACH_ROLE_ID=your_coach_role_id

# Admin rolünün ID'si
ADMIN_ROLE_ID=your_admin_role_id

# =============================================
# KANALLAR
# =============================================

# Kayıt loglarının gönderileceği kanal ID'si
REGISTER_LOG_CHANNEL_ID=your_register_log_channel_id

# Ders loglarının gönderileceği kanal ID'si
LESSON_LOG_CHANNEL_ID=your_lesson_log_channel_id

# =============================================
# VERİTABANI (Railway PostgreSQL)
# =============================================
DATABASE_URL=postgresql://user:password@host:port/database

# =============================================
# ORTAM
# =============================================
NODE_ENV=production
