# Discord Configuration
DISCORD_TOKEN=your_discord_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# Role IDs
STUDENT_ROLE_ID=your_student_role_id_here
COACH_ROLE_ID=your_coach_role_id_here

# Sınıf Ses Kanalları (Grup Dersleri kategorisi altındaki kanalların ID'leri)
CLASS_A_CHANNEL_ID=your_class_a_channel_id_here
CLASS_B_CHANNEL_ID=your_class_b_channel_id_here
CLASS_C_CHANNEL_ID=your_class_c_channel_id_here

# Firebase Configuration
# Option 1: Use full service account JSON
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Option 2: Use individual variables
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_CLIENT_X509_CERT_URL=your_cert_url
